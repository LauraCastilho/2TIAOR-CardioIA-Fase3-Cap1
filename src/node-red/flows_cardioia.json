  {
    "id": "f0f0f0f0f0f00001",
    "type": "function",
    "z": "f1a0c0d1e2f30001",
    "name": "Avaliar limites (fog)",
    "func": "// Camada fog: reavalia os limites clínicos com os dados recebidos do ESP32.\n// Os limites são os mesmos do firmware, mas ficam aqui para que a equipe\n// clínica possa ajustá-los sem regravar o dispositivo.\nconst LIMITES = { bpmMax: 120, bpmMin: 50, tempMax: 38.0, tempMin: 35.0 };\n\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null) {\n    node.warn('Mensagem ignorada: payload não é JSON');\n    return null;\n}\n\nconst criticos = [];\nconst avisos = [];\n\nif (d.bpm === 0) avisos.push('Sem pulso detectado (verificar sensor)');\nelse if (d.bpm > LIMITES.bpmMax) criticos.push(`Taquicardia: ${d.bpm} bpm`);\nelse if (d.bpm < LIMITES.bpmMin) criticos.push(`Bradicardia: ${d.bpm} bpm`);\n\nif (d.temp === null || d.temp === undefined) avisos.push('Falha na leitura do DHT22');\nelse if (d.temp >= LIMITES.tempMax) criticos.push(`Febre: ${d.temp.toFixed(1)} °C`);\nelse if (d.temp < LIMITES.tempMin) criticos.push(`Hipotermia: ${d.temp.toFixed(1)} °C`);\n\nlet nivel = 'normal';\nif (avisos.length) nivel = 'atencao';\nif (criticos.length) nivel = 'critico';\n\nconst titulos = { normal: 'Sinais dentro dos limites', atencao: 'Atenção', critico: 'ALERTA' };\nconst tempTxt = (d.temp === null || d.temp === undefined) ? '--' : d.temp.toFixed(1) + ' °C';\nconst umidTxt = (d.umid === null || d.umid === undefined) ? '--' : d.umid.toFixed(0) + '% umid.';\nconst status = {\n    nivel,\n    titulo: titulos[nivel],\n    texto: criticos.concat(avisos).join(' | ') || `${d.bpm} bpm · ${tempTxt} · ${umidTxt}`,\n    hora: new Date().toLocaleTimeString('pt-BR')\n};\n\n// A saída 5 só dispara quando o nível muda para crítico, para não repetir\n// o mesmo alerta a cada leitura (ponto de integração para notificações).\nlet evento = null;\nconst anterior = context.get('nivel') || 'normal';\nif (nivel === 'critico' && anterior !== 'critico') {\n    evento = { payload: { paciente: d.paciente, seq: d.seq, alertas: criticos, recebido_em: new Date().toISOString() } };\n}\ncontext.set('nivel', nivel);\n\nreturn [\n    d.bpm > 0 ? { topic: 'BPM', payload: d.bpm } : null,\n    (d.temp === null || d.temp === undefined) ? null : { payload: d.temp },\n    (d.umid === null || d.umid === undefined) ? null : { payload: d.umid },\n    { payload: status },\n    evento\n];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 120,
    "wires": [
      [
        "a3a3a3a3a3a30001"
      ],
      [
        "a3a3a3a3a3a30002"
      ],
      [
        "a3a3a3a3a3a30003"
      ],
      [
        "a3a3a3a3a3a30004"
      ],
      [
        "a2a2a2a2a2a20002"
      ]
    ],
    "outputLabels": [
      "bpm",
      "temperatura",
      "umidade",
      "status de alerta",
      "novo alerta crítico"
    ]
