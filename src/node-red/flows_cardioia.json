  {
    "id": "f0f0f0f0f0f00002",
    "type": "function",
    "z": "f1a0c0d1e2f30001",
    "name": "Formatar 'sem dados'",
    "func": "// Disparado pelo watchdog quando o ESP32 fica 20 s sem publicar.\nmsg.payload = {\n    nivel: 'sem_dados',\n    titulo: 'Sem dados do dispositivo',\n    texto: 'Nenhuma leitura nos últimos 20 s. O wearable pode estar sem conexão; as leituras ficam no buffer local.',\n    hora: new Date().toLocaleTimeString('pt-BR')\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 300,
    "wires": [
      [
        "a3a3a3a3a3a30004"
      ]
    ]
  },
  {
    "id": "f0f0f0f0f0f00003",
    "type": "function",
    "z": "f1a0c0d1e2f30001",
    "name": "Contar sincronizadas",
    "func": "// Leituras que ficaram no buffer do ESP32 durante a queda de conexão.\n// Por enquanto só contamos e exibimos; numa próxima fase elas iriam para um banco.\nlet total = flow.get('sincronizadas') || 0;\nlet ultimoSeq = flow.get('ultimoSeqHistorico') || 0;\nconst d = msg.payload;\n\nif (d && typeof d.seq === 'number') {\n    if (d.seq === ultimoSeq) return null;   // descarta duplicata óbvia\n    ultimoSeq = d.seq;\n}\ntotal += 1;\nflow.set('sincronizadas', total);\nflow.set('ultimoSeqHistorico', ultimoSeq);\n\nmsg.payload = `${total} leituras recuperadas do buffer (última seq ${ultimoSeq}, às ${new Date().toLocaleTimeString('pt-BR')})`;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 460,
    "wires": [
      [
        "a3a3a3a3a3a30005"
      ]
    ]
  },
  {
    "id": "f0f0f0f0f0f00004",
    "type": "function",
    "z": "f1a0c0d1e2f30001",
    "name": "Formatar status",
    "func": "const online = String(msg.payload).trim() === 'online';\nmsg.payload = online ? '🟢 Online' : '🔴 Offline (Last Will recebido)';\nreturn msg;",
