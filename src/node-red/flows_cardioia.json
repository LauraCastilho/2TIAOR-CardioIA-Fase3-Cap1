  {
    "id": "a3a3a3a3a3a30004",
    "type": "ui_template",
    "z": "f1a0c0d1e2f30001",
    "group": "d0d0d0d0d0d00002",
    "name": "LED de alerta",
    "order": 1,
    "width": "6",
    "height": "3",
    "format": "<style>\n  .cardio-alerta { display: flex; align-items: center; gap: 18px; padding: 6px 4px; }\n  .cardio-led { width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0;\n                background: #95a5a6; box-shadow: 0 0 10px rgba(0,0,0,.35) inset; }\n  .cardio-led.normal    { background: #27ae60; box-shadow: 0 0 18px #27ae60; }\n  .cardio-led.atencao   { background: #f39c12; box-shadow: 0 0 18px #f39c12; }\n  .cardio-led.critico   { background: #e74c3c; box-shadow: 0 0 22px #e74c3c; animation: cardio-pisca 0.8s infinite; }\n  .cardio-led.sem_dados { background: #7f8c8d; }\n  .cardio-titulo { font-size: 20px; font-weight: bold; }\n  .cardio-texto  { font-size: 14px; opacity: .85; }\n  @keyframes cardio-pisca { 50% { opacity: .25; } }\n</style>\n<div class=\"cardio-alerta\">\n  <div class=\"cardio-led\" ng-class=\"msg.payload.nivel\"></div>\n  <div>\n    <div class=\"cardio-titulo\">{{msg.payload.titulo || 'Aguardando dados...'}}</div>\n    <div class=\"cardio-texto\">{{msg.payload.texto}}</div>\n    <div class=\"cardio-texto\" ng-if=\"msg.payload.hora\">Atualizado às {{msg.payload.hora}}</div>\n  </div>\n</div>",
    "storeOutMessages": true,
